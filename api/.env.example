# API port (front uses 3000, backoffice 3001, Strapi 1337)
API_PORT=4000

# Supabase database connection (the same one Strapi uses in back/)
DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# Allowed CORS origins, comma-separated
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Same JWT_SECRET Strapi used historically — this keeps tokens issued
# before the migration valid
JWT_SECRET=

# Cloudinary (same values as back/.env)
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Staff emails (CSV) — same rule as back/ and backoffice/
STAFF_EMAILS=admin@irisnatural.com

# Google OAuth (same values as back/.env)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public URL of this API (for the OAuth callback) and of the storefront
PUBLIC_URL=http://localhost:4000
CLIENT_URL=http://localhost:3000

# SMTP for forgot-password (same names as back/)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@irisnatural.com
